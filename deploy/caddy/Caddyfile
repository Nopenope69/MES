# Antigravity SMT MES - Edge Perimeter Gateway Caddyfile
# Section 4 Customer Readiness Hardening: TLS 1.3, HSTS, Defense-in-Depth Headers

{
    admin off
}

# Ingress Port 80: HTTP to HTTPS 301 Permanent Redirect
:80 {
    redir https://{host}{uri} permanent
}

# Ingress Port 443: Hardened TLS Edge Proxy
:443 {
    tls internal {
        protocols tls1.2 tls1.3
    }

    # Enterprise Defense-in-Depth Security Headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
        Content-Security-Policy "default-src 'self'; script-src 'self' https://unpkg.com 'unsafe-inline'; style-src 'self' https://unpkg.com 'unsafe-inline'; img-src 'self' data:;"
    }

    # Block Prometheus /metrics from public LAN edge exposure
    @metrics {
        path /metrics
    }
    respond @metrics "Forbidden" 403

    # Reverse proxy routing: /api/* -> mes-api:4000
    handle /api/* {
        reverse_proxy mes-api:4000
    }

    # Reverse proxy routing: /* -> mes-web:80 (Cleanroom Web UI)
    handle {
        reverse_proxy mes-web:80
    }
}
