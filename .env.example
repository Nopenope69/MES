# ==============================================================================
# SMT MES Engine - Environment Configuration Template (.env.example)
# ==============================================================================
# COPY THIS FILE TO .env AND POPULATE SECRETS ACCORDING TO YOUR DEPLOYMENT.
# NEVER COMMIT UNMASKED SECRETS TO SOURCE CONTROL.

# General Server Configuration
NODE_ENV=development
PORT=4000
FUJI_PORT=30040

# Database Configuration (PostgreSQL / SQLite fallback)
# Production PostgreSQL connection string:
# DATABASE_URL=postgresql://mesuser:mespassword@localhost:5432/smt_mes
DATABASE_URL=

# Industrial OT Network Security (Comma-separated CIDRs or IPs allowed to connect to Fuji TCP Gateway)
# Example: 127.0.0.1,::1,192.168.10.0/24
SMT_ALLOWED_SUBNET=127.0.0.1,::1,192.168.10.0/24

# Authentication & API Gateway Secrets
# In production, must be at least 32 characters of high-entropy cryptographic randomness
JWT_SECRET=dev-jwt-secret-do-not-use-in-production-min-32chars
API_KEY_SECRET=dev-mes-api-key-secret-2026-strict-hygiene

# HashiCorp Vault / Cloud Secret Store (Optional)
VAULT_ADDR=
VAULT_TOKEN=
VAULT_SECRET_PATH=secret/data/smt-mes
