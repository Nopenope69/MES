    'Usage: node [options] [ script.js ] [arguments]\n' +
    '       node inspect [options] [ script.js | host:port ] [arguments]\n\n' +
    'Options:\n');
  helpText += (indent(format({
    options, aliases, firstColumn, secondColumn,
  }), 2));

  helpText += ('\nEnvironment variables:\n');

  helpText += (format({
